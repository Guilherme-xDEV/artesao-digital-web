rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function perfilPath(uid) {
      return /databases/$(database)/documents/artesaos/$(uid);
    }

    // Numeric artisan IDs are retained only to recognize documents written by
    // older Android builds. New writes always use the Firebase Auth UID.
    function donoPorIdentificador(artesaoId) {
      return logado() && (
        artesaoId == request.auth.uid
        || (
          artesaoId is int
          && exists(perfilPath(request.auth.uid))
          && get(perfilPath(request.auth.uid)).data.id == artesaoId
        )
      );
    }

    function produtoPath(produtoId) {
      return /databases/$(database)/documents/produtos/$(produtoId);
    }

    function precoProdutoValido(data) {
      return (
        data.keys().hasAny(['precoCentavos'])
        && data.precoCentavos is int
        && data.precoCentavos > 0
      ) || (
        data.keys().hasAny(['preco'])
        && data.preco is number
        && data.preco > 0
      );
    }

    function precoProdutoEmCentavos(data) {
      return data.keys().hasAny(['precoCentavos'])
        ? data.precoCentavos
        : math.round(data.preco * 100);
    }

    function produtoValido(data) {
      return data.nome is string
        && data.nome.size() >= 2
        && data.nome.size() <= 100
        && data.descricao is string
        && data.descricao.size() <= 500
        && precoProdutoValido(data)
        && data.quantidadeEstoque is int
        && data.quantidadeEstoque >= 0
        && data.ativo is bool;
    }

    match /artesaos/{uid} {
      allow read: if logado() && request.auth.uid == uid;

      allow create: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly([
                      'id', 'uid', 'nome', 'telefone', 'email', 'criadoEm'
                    ])
                    && request.resource.data.id is int
                    && request.resource.data.uid == uid
                    && request.resource.data.nome is string
                    && request.resource.data.email is string;

      // id/uid are backfilled once for profiles originally created by the web
      // app, allowing old numeric product ownership to be migrated safely.
      allow update: if logado()
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['nome', 'telefone', 'id', 'uid'])
                    && request.resource.data.id is int
                    && request.resource.data.uid == uid;

      allow delete: if false;
    }

    match /produtos/{id} {
      allow read: if logado();

      // Canonical product writes use UID ownership and integer cents.
      allow create: if logado()
                    && request.resource.data.artesaoId == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'id', 'firestoreId', 'nome', 'descricao',
                      'precoCentavos', 'quantidadeEstoque',
                      'artesaoId', 'artesaoNome', 'qrCodeId',
                      'ativo', 'criadoEm'
                    ])
                    && produtoValido(request.resource.data)
                    && request.resource.data.artesaoNome is string
                    && request.resource.data.qrCodeId == id
                    && request.resource.data.ativo == true
                    && request.resource.data.precoCentavos is int
                    && request.resource.data.criadoEm == request.time
                    && (
                      !request.resource.data.keys().hasAny(['id'])
                      || request.resource.data.id is int
                    )
                    && (
                      !request.resource.data.keys().hasAny(['firestoreId'])
                      || request.resource.data.firestoreId == id
                    );

      allow update: if logado()
                    && produtoValido(request.resource.data)
                    && request.resource.data.qrCodeId == resource.data.qrCodeId
                    && (
                      !request.resource.data.keys().hasAny(['firestoreId'])
                      || request.resource.data.firestoreId == id
                    )
                    && (
                      (
                        donoPorIdentificador(resource.data.artesaoId)
                        && (
                          request.resource.data.artesaoId == resource.data.artesaoId
                          || (
                            resource.data.artesaoId is int
                            && request.resource.data.artesaoId == request.auth.uid
                          )
                        )
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly([
                             'id', 'firestoreId', 'nome', 'descricao',
                             'preco', 'precoCentavos', 'quantidadeEstoque',
                             'artesaoId', 'artesaoNome', 'qrCodeId', 'ativo',
                             'atualizadoEm', 'ultimaVendaId'
                           ])
                        && request.resource.data.artesaoNome is string
                      )
                      ||
                      (
                        !donoPorIdentificador(resource.data.artesaoId)
                        && request.resource.data.artesaoId == resource.data.artesaoId
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly([
                             'quantidadeEstoque', 'atualizadoEm', 'ultimaVendaId'
                           ])
                        && request.resource.data.quantidadeEstoque < resource.data.quantidadeEstoque
                        && request.resource.data.ultimaVendaId is string
                        && existsAfter(/databases/$(database)/documents/vendas/$(request.resource.data.ultimaVendaId))
                        && getAfter(/databases/$(database)/documents/vendas/$(request.resource.data.ultimaVendaId)).data.produtoId == id
                        && getAfter(/databases/$(database)/documents/vendas/$(request.resource.data.ultimaVendaId)).data.vendedorId == request.auth.uid
                        && getAfter(/databases/$(database)/documents/vendas/$(request.resource.data.ultimaVendaId)).data.quantidade ==
                           resource.data.quantidadeEstoque - request.resource.data.quantidadeEstoque
                      )
                    );

      allow delete: if false;
    }

    match /vendas/{id} {
      allow read: if logado()
                  && (
                    resource.data.vendedorId == request.auth.uid
                    || donoPorIdentificador(resource.data.artesaoId)
                  );

      allow create: if logado()
                    && request.resource.data.keys().hasOnly([
                      'produtoId', 'produtoNome', 'artesaoId', 'artesaoNome',
                      'vendedorId', 'vendedorNome', 'precoUnitarioCentavos',
                      'quantidade', 'totalCentavos', 'dataHora'
                    ])
                    && request.resource.data.produtoId is string
                    && request.resource.data.produtoNome is string
                    && (
                      request.resource.data.artesaoId is string
                      || request.resource.data.artesaoId is int
                    )
                    && request.resource.data.artesaoNome is string
                    && request.resource.data.vendedorId == request.auth.uid
                    && request.resource.data.vendedorNome is string
                    && request.resource.data.quantidade is int
                    && request.resource.data.quantidade >= 1
                    && request.resource.data.precoUnitarioCentavos is int
                    && request.resource.data.precoUnitarioCentavos > 0
                    && request.resource.data.totalCentavos is int
                    && request.resource.data.totalCentavos ==
                       request.resource.data.precoUnitarioCentavos * request.resource.data.quantidade
                    && request.resource.data.dataHora == request.time
                    && exists(produtoPath(request.resource.data.produtoId))
                    && get(produtoPath(request.resource.data.produtoId)).data.ativo == true
                    && get(produtoPath(request.resource.data.produtoId)).data.nome == request.resource.data.produtoNome
                    && get(produtoPath(request.resource.data.produtoId)).data.artesaoId == request.resource.data.artesaoId
                    && (
                      !get(produtoPath(request.resource.data.produtoId)).data.keys().hasAny(['artesaoNome'])
                      || get(produtoPath(request.resource.data.produtoId)).data.artesaoNome == request.resource.data.artesaoNome
                    )
                    && precoProdutoEmCentavos(get(produtoPath(request.resource.data.produtoId)).data) ==
                       request.resource.data.precoUnitarioCentavos
                    && getAfter(produtoPath(request.resource.data.produtoId)).data.quantidadeEstoque ==
                       get(produtoPath(request.resource.data.produtoId)).data.quantidadeEstoque - request.resource.data.quantidade
                    && getAfter(produtoPath(request.resource.data.produtoId)).data.ultimaVendaId == id;

      allow update, delete: if false;
    }
  }
}
