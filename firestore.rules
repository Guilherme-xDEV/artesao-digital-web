rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function dono(uid) { return logado() && request.auth.uid == uid; }

    // Artesãos: cada um lê e edita apenas o próprio perfil; nunca apaga.
    match /artesaos/{uid} {
      allow read: if logado();
      allow create: if dono(uid);
      allow update: if dono(uid);
      allow delete: if false;
    }

    // Produtos: leitura autenticada permite identificar itens durante uma venda.
    // O ID do documento é o UUID codificado no QR Code.
    match /produtos/{id} {
      allow read: if logado();

      allow create: if dono(request.resource.data.artesaoId)
                    && request.resource.data.qrCodeId == id
                    && request.resource.data.ativo == true
                    && request.resource.data.precoCentavos > 0
                    && request.resource.data.quantidadeEstoque >= 0;

      // O proprietário pode editar os dados comerciais, mas não pode trocar
      // o dono nem o identificador permanente do QR Code.
      allow update: if logado()
                    && request.resource.data.artesaoId == resource.data.artesaoId
                    && request.resource.data.qrCodeId == resource.data.qrCodeId
                    && request.resource.data.precoCentavos > 0
                    && request.resource.data.quantidadeEstoque >= 0
                    && (
                      dono(resource.data.artesaoId)
                      || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantidadeEstoque'])
                    );

      // A exclusão é lógica (ativo = false), preservando o histórico.
      allow delete: if false;
    }

    // Vendas: somente criação (irretratabilidade). Lê quem vendeu ou o dono do produto.
    match /vendas/{id} {
      allow read: if logado()
                  && (resource.data.vendedorId == request.auth.uid
                      || resource.data.artesaoId == request.auth.uid);
      allow create: if dono(request.resource.data.vendedorId)
                    && request.resource.data.quantidade >= 1
                    && request.resource.data.totalCentavos ==
                       request.resource.data.precoUnitarioCentavos * request.resource.data.quantidade;
      allow update, delete: if false;
    }
  }
}
